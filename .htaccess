# ==============================================================================
# sendandsign.online — Hostinger (LiteSpeed) .htaccess
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS and non-www (canonical domain)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.sendandsign\.online$ [NC]
  RewriteRule ^(.*)$ https://sendandsign.online/$1 [R=301,L]

  # 2. Automatically serve WebP if browser supports it and .webp file exists
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} (.+)\.(jpe?g|png)$ [NC]
  RewriteCond %1.webp -f
  RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=REQUEST_image,L]

  # 3. Redirect /index.html to root /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 4. Redirect explicit .html requests to clean URLs (preserves query strings)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 5. Internally serve .html files for clean URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ==============================================================================
# WebP MIME Type & Proxy/CDN Cache Header
# ==============================================================================
AddType image/webp .webp

<IfModule mod_headers.c>
  # Ensures CDNs and proxies cache WebP and PNG/JPG versions separately
  Header append Vary Accept env=REQUEST_image

  # Basic security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==============================================================================
# Browser Caching
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: short cache so site updates appear quickly
  ExpiresByType text/html "access plus 1 hour"

  # Images & icons
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Styles, scripts & fonts
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
